# Base de datos
DATABASE_URL="sqlite:./prisma/dev.db"

# JWT - REQUERIDO EN PRODUCCIÓN
JWT_SECRET="tu-super-secret-key-minimo-32-caracteres-aleatorios"

# Servidor
PORT=5000
NODE_ENV=development

# CORS y Socket.io
CORS_ORIGIN=http://localhost:3000
SOCKET_IO_ORIGIN=http://localhost:3000

# Nota: JWT_SECRET es OBLIGATORIO. Si no se proporciona, el servidor no iniciará
# Generar una clave segura: openssl rand -hex 32
